---
interface Props {
  tags: string[];
  linked?: boolean;
}

const { tags, linked = true } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {tags.map((tag) =>
    linked ? (
      <a href={`/tags/${tag.toLowerCase()}`} class="tag hover:bg-primary-200 dark:hover:bg-primary-800/40 transition-colors">
        {tag}
      </a>
    ) : (
      <span class="tag">{tag}</span>
    )
  )}
</div>
