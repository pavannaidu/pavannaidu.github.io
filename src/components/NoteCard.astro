---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
  note: CollectionEntry<'notes'>;
  featured?: boolean;
}

const { note, featured = false } = Astro.props;
const { title, date, description, tags, image } = note.data;
---

<article class="card-hover group">
  <a href={`/notes/${note.slug}`} class="block">
    {image && featured && (
      <div class="aspect-video overflow-hidden rounded-t-xl">
        <img
          src={image}
          alt={title}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </div>
    )}
    <div class="p-5">
      <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-2">
        <FormattedDate date={date} />
      </div>

      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2">
        {title}
      </h3>

      {description && (
        <p class="text-gray-600 dark:text-gray-300 text-sm mb-3 line-clamp-2">
          {description}
        </p>
      )}

      {tags.length > 0 && (
        <div class="mt-3">
          <TagList tags={tags.slice(0, 3)} linked={false} />
        </div>
      )}
    </div>
  </a>
</article>
