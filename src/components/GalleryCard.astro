---
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'gallery'>;
}

const { item } = Astro.props;
const { title, description, image, imageAlt, technologies } = item.data;
---

<article class="card-hover group overflow-hidden">
  <a href={`/gallery/${item.slug}`} class="block">
    <div class="aspect-[4/3] overflow-hidden">
      <img
        src={image}
        alt={imageAlt || title}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </div>
    <div class="p-5">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
        {title}
      </h3>

      {description && (
        <p class="text-gray-600 dark:text-gray-300 text-sm mb-3 line-clamp-2">
          {description}
        </p>
      )}

      {technologies.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {technologies.slice(0, 3).map((tech) => (
            <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
              {tech}
            </span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>
