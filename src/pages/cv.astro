---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/data/siteConfig';
---

<BaseLayout title="CV" description="Professional experience, education, and research.">
  <section class="py-12 md:py-16">
    <div class="container-narrow">
      <header class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-3">
          Curriculum Vitae
        </h1>
      </header>

      <div class="space-y-10">
        <!-- Education -->
        <section>
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M12 14l9-5-9-5-9 5 9 5z" />
              <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
            </svg>
            Education
          </h2>
          <div class="space-y-4">
            <div class="card p-5">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-white">Carnegie Mellon University</h3>
                  <p class="text-primary-600 dark:text-primary-400">M.S. in Information Systems Management</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-sm text-gray-500 dark:text-gray-400">2018 - 2019</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Pittsburgh, PA</p>
                </div>
              </div>
            </div>
            <div class="card p-5">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-white">Visvesvaraya Technological University</h3>
                  <p class="text-primary-600 dark:text-primary-400">B.S. in Electronics and Communications Engineering</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-sm text-gray-500 dark:text-gray-400">2012 - 2016</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Mysore, KA</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Work Experience -->
        <section>
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Work Experience
          </h2>
          <div class="space-y-4">
            <div class="card p-5">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-white">Databricks Inc.</h3>
                  <p class="text-primary-600 dark:text-primary-400">Solutions Architect</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-sm text-gray-500 dark:text-gray-400">07/2024 - Present</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Houston, TX</p>
                </div>
              </div>
            </div>
            <div class="card p-5">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-white">QuantumBlack, McKinsey & Company</h3>
                  <p class="text-primary-600 dark:text-primary-400">Senior Data Scientist</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-sm text-gray-500 dark:text-gray-400">02/2020 - 07/2024</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Boston, MA; Houston, TX</p>
                </div>
              </div>
            </div>
            <div class="card p-5">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-white">Indeed</h3>
                  <p class="text-primary-600 dark:text-primary-400">Business Intelligence Intern</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-sm text-gray-500 dark:text-gray-400">05/2019 - 08/2019</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">New York City, NY</p>
                </div>
              </div>
            </div>
            <div class="card p-5">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-white">Carnegie Mellon University</h3>
                  <p class="text-primary-600 dark:text-primary-400">Marketing Assistant</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-sm text-gray-500 dark:text-gray-400">09/2018 - 12/2019</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Pittsburgh, PA</p>
                </div>
              </div>
            </div>
            <div class="card p-5">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-white">Thorogood Associates</h3>
                  <p class="text-primary-600 dark:text-primary-400">Business Intelligence & Analytics Consultant</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-sm text-gray-500 dark:text-gray-400">06/2016 - 06/2018</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Bangalore, KA</p>
                </div>
              </div>
            </div>
            <div class="card p-5">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <h3 class="font-medium text-gray-900 dark:text-white">Thorogood Associates</h3>
                  <p class="text-primary-600 dark:text-primary-400">Business Intelligence Intern</p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-sm text-gray-500 dark:text-gray-400">12/2015 - 04/2016</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">Bangalore, KA</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Research -->
        <section>
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
            Research
          </h2>
          <div class="space-y-4">
            <div class="card p-5">
              <h3 class="font-medium text-gray-900 dark:text-white">Identifying toxicity and bias in online comments using RNN and word embeddings</h3>
              <a href="https://www.youtube.com/watch?v=QLqVYA6RhL0" target="_blank" rel="noopener noreferrer" class="text-sm link">
                View demo &rarr;
              </a>
            </div>
            <div class="card p-5">
              <h3 class="font-medium text-gray-900 dark:text-white">Simpsons, through the seasons</h3>
              <a href="https://www.youtube.com/watch?v=C6FL1cF4DlU" target="_blank" rel="noopener noreferrer" class="text-sm link">
                View demo &rarr;
              </a>
            </div>
            <div class="card p-5">
              <h3 class="font-medium text-gray-900 dark:text-white">An Efficient Recursive Technique for Braille Dot Extraction in Optical Braille Recognition through Frequency Domain Approach</h3>
              <a href="https://www.researchgate.net/profile/Shreekanth-T/publication/309672514" target="_blank" rel="noopener noreferrer" class="text-sm link">
                View paper &rarr;
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
